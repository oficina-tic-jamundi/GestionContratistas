# Ruta base de la API vista desde el navegador (mismo origen).
VITE_API_BASE_URL=/api/v1

# Solo desarrollo: a dónde reenvía Vite las peticiones /api (servidor PHP local).
DEV_API_PROXY_TARGET=http://127.0.0.1:8080
