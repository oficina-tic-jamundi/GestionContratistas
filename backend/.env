# ============================================================
# SIGCON API — variables de entorno
# Copie este archivo como .env y complete los valores.
# El archivo .env NUNCA debe subirse a Git.
# En producción, ubique el .env fuera del document root.
# ============================================================

# --- Aplicación ---
# Valores permitidos: development | testing | production
APP_ENV=development
# true solo en desarrollo: incluye detalles técnicos en los logs de error (nunca en la respuesta HTTP en producción)
APP_DEBUG=true
# URL pública de la aplicación (frontend). Se usa para enlaces en notificaciones.
APP_URL=http://localhost:5173
# Prefijo bajo el cual se sirve la API (vacío si la API está en la raíz del (sub)dominio)
APP_BASE_PATH=/api
APP_TIMEZONE=America/Bogota

# --- Base de datos (MySQL / MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=sigcon
DB_USERNAME=sigcon
DB_PASSWORD=e27510e43b59b310e838664a3d92b0c0
DB_CHARSET=utf8mb4

# --- Seguridad / autenticación (Fase 1) ---
# Clave aleatoria de 32+ bytes en base64. Generar con: php bin/console key:generate
AUTH_SECRET=b4KdvyhjrbcKhIVqCYDc6WN3cz6Lib1pNmTpKq7Zr3k=
# Minutos de inactividad antes de expirar la sesión
SESSION_IDLE_MINUTES=30
# Horas máximas de vida de una sesión aunque haya actividad
SESSION_ABSOLUTE_HOURS=10
# true en producción (HTTPS obligatorio)
SESSION_COOKIE_SECURE=false

# --- Almacenamiento ---
# Ruta absoluta o relativa a backend/. Debe estar FUERA del document root.
STORAGE_PATH=storage/app
LOG_PATH=storage/logs
# debug | info | notice | warning | error
LOG_LEVEL=debug
# Tamaño máximo de carga en MB (también debe permitirlo php.ini: upload_max_filesize / post_max_size)
UPLOAD_MAX_SIZE_MB=15

# --- Google Drive institucional (Fase 7) ---
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Ruta ABSOLUTA al JSON de la service account, fuera del document root y fuera del repositorio
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

# --- Tareas programadas (cron) ---
# Segundos máximos por ejecución del procesador de trabajos (menor que el intervalo del cron)
JOBS_MAX_RUNTIME_SECONDS=50

# --- Pruebas de integración (base de datos dedicada, se recrea en cada ejecución) ---
TEST_DB_DATABASE=sigcon_test
